{
  "name": "uikigai-ai-workforce-os-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test:demo": "node scripts/check-demo-routes.mjs",
    "check:stitch": "node scripts/validate-stitch-ui.mjs",
    "normalize:stitch": "node scripts/normalize-stitch-names.mjs",
    "parity:check": "node scripts/visual-parity-check.mjs",
    "parity:regions": "node scripts/analyze-parity-regions.mjs",
    "parity:offsets": "node scripts/analyze-parity-offsets.mjs",
    "audit:bbox:08": "node scripts/audit-screen-08-bboxes.mjs",
    "audit:bbox:21": "node scripts/audit-screen-bboxes.mjs --screen=21 --route=/org-chart --contract=docs/11-quality/screen-21-layout-contract.json --out=parity-reports/21_org-chart-view/bbox-report.json",
    "audit:bbox:23": "node scripts/audit-screen-bboxes.mjs --screen=23 --route=/agents/demo-agent --contract=docs/11-quality/screen-23-layout-contract.json --out=parity-reports/23_agent-detail/bbox-report.json",
    "audit:bbox:20": "node scripts/audit-screen-bboxes.mjs --screen=20 --route=/workforce --contract=docs/11-quality/screen-20-layout-contract.json --out=parity-reports/20_ai-workforce-overview/bbox-report.json",
    "audit:bbox:30": "node scripts/audit-screen-bboxes.mjs --screen=30 --route=/tickets --contract=docs/11-quality/screen-30-layout-contract.json --out=parity-reports/30_tickets-board/bbox-report.json",
    "audit:bbox:32": "node scripts/audit-screen-bboxes.mjs --screen=32 --route=/tickets/demo-ticket --contract=docs/11-quality/screen-32-layout-contract.json --out=parity-reports/32_ticket-detail/bbox-report.json",
    "audit:bbox:34": "node scripts/audit-screen-bboxes.mjs --screen=34 --route=/runs/demo-run --contract=docs/11-quality/screen-34-layout-contract.json --out=parity-reports/34_run-console/bbox-report.json",
    "audit:bbox:37": "node scripts/audit-screen-bboxes.mjs --screen=37 --route=/approvals --contract=docs/11-quality/screen-37-layout-contract.json --out=parity-reports/37_approval-center/bbox-report.json",
    "smoke:real-ui-flow": "node scripts/smoke-real-ui-demo-flow.mjs",
    "parity:core": "node scripts/visual-parity-check.mjs --ids=8,20,21,23,30,32,34,37",
    "codegraph:init": "codegraph init -i",
    "codegraph:index": "codegraph index",
    "codegraph:sync": "codegraph sync",
    "codegraph:status": "codegraph status --json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^0.7.12",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.10.0",
    "eslint": "latest",
    "pixelmatch": "latest",
    "playwright": "latest",
    "pngjs": "latest",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "latest"
  }
}
